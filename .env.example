# ==============================================================================
# Supabase Project Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual Supabase credentials.
# You can find these values in your Supabase Project Settings:
# Settings -> API & Settings -> Database
# ==============================================================================

# Public API Base URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Direct REST Endpoint (Convenience URL, automatically derived if omitted)
SUPABASE_REST_URL=https://your-project-id.supabase.co/rest/v1

# Public anonymous key (Safe to expose to browser client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Secret service role key (Bypasses RLS - FOR SERVER SCRIPTS ONLY, NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Direct database connection password (used for migrations/direct postgres connections)
SUPABASE_DB_PASSWORD=your-database-password

# Supabase Project Reference ID (e.g., xyzcompany)
SUPABASE_PROJECT_ID=your-project-id

# Direct PostgreSQL Connection Strings
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres.your-project-id:your-database-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
